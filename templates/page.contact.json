        "faq_where": { "type": "faq", "settings": {
          "question": "Where is my order?",
          "answer": "<p>Your dispatch email carries a tracking number. Enter it on our <a href=\"/pages/track-order\">tracking page</a>, or follow the link in the email. If you only have the order confirmation, the order has not left the warehouse yet.</p><p>Tracking can take up to 24 hours to show its first scan. If it has not moved for three working days, tell us and we will chase the carrier ourselves.</p>" } },

        "faq_howlong": { "type": "faq", "settings": {
          "question": "How long will delivery take?",
          "answer": "<p>Standard is 2–4 working days and costs £4.99, free on orders of £50 and over. Express is 1–2 working days at £6.99. Allow one working day for us to dispatch on top of that.</p><p>Everything is sent tracked from within the UK, so there is nothing to pay on arrival. Full detail on the <a href=\"/pages/delivery\">delivery page</a>.</p>" } },

        "faq_highlands": { "type": "faq", "settings": {
          "question": "Do you deliver to the Highlands, the islands or Northern Ireland?",
          "answer": "<p>Yes, at the same rate as everywhere else in the UK. Some remote postcodes take an extra one to two working days, and Express is not available to them. If you pay for Express to a postcode the carrier cannot serve, we refund the difference rather than keep it.</p>" } },

        "faq_returns": { "type": "faq", "settings": {
          "question": "Can I send something back if I change my mind?",
          "answer": "<p>Yes. You have 14 days from delivery to tell us, and another 14 to return it. Return postage for a change of mind is yours; for anything faulty it is ours.</p><p>Full instructions are on the <a href=\"/pages/returns\">returns page</a>.</p>" } },

        "faq_damaged": { "type": "faq", "settings": {
          "question": "Something arrived damaged. What now?",
          "answer": "<p>Photograph it in the packaging and <a href=\"/pages/contact\">tell us</a> within 48 hours. We will replace it and we pay the postage both ways.</p><p>Please do not install a fitting you believe to be damaged, and open the box before your electrician arrives — it is far easier to put right before anything has been wired in.</p>" } },

        "faq_electrician": { "type": "faq", "settings": {
          "question": "Do I need an electrician?",
          "answer": "<p>For anything wired into the mains, yes. Fixed electrical work in a home in England and Wales falls under Part P of the Building Regulations, and bathrooms have their own zone rules under BS 7671.</p><p>Plug-in table and floor lamps need no installation at all.</p>" } },

        "faq_bathroom": { "type": "faq", "settings": {
          "question": "Can I use this in a bathroom?",
          "answer": "<p>Only if the fitting carries an IP rating suitable for the zone it is going in. Where a fitting is rated, we state the rating on the product page; where it is not rated, it is not for a bathroom, and we will not imply otherwise.</p><p>If you are unsure, ask us before you buy.</p>" } },

        "faq_vat": { "type": "faq", "settings": {
          "question": "Are your prices inclusive of VAT?",
          "answer": "<p>We are not currently registered for VAT, so no VAT is charged and none is added at checkout. The price on the product page is the price you pay, plus delivery. We cannot issue a VAT invoice.</p>" } },

        "faq_finish": { "type": "faq", "settings": {
          "question": "Will the finish change over time?",
          "answer": "<p>Some of them are meant to. Unlacquered brass and similar living finishes darken and mark with handling and age, and two pieces will never be quite identical. We say so on the product page.</p><p>That is the material behaving as it should, not a fault — but if you want a finish that stays exactly as it arrived, tell us and we will point you at one.</p>" } }
