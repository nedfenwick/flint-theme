{%- comment -%}
  FLINT — JOURNAL INDEX (§32)
  Two streams plus projects, filtered by tag. Guides are search-led and
  evergreen; Stories build taste; Projects carry trade credibility.
{%- endcomment -%}

<div class="flint-container">

  <div class="flint-journal__masthead">
    {% render 'flint-logo', colour: '#2A2724', width: '104px' %}
    <div style="width:1px;height:18px;background:var(--border-default);"></div>
    <span class="flint-label">{{ blog.title }}</span>

    <nav class="flint-journal__tabs" aria-label="Journal sections">
      <a href="{{ blog.url }}" {% unless current_tags %}aria-current="page"{% endunless %}>All</a>
      {%- for tag in blog.all_tags -%}
        <a href="{{ blog.url }}/tagged/{{ tag | handleize }}"
           {% if current_tags contains tag %}aria-current="page"{% endif %}>{{ tag }}</a>
      {%- endfor -%}
    </nav>
  </div>

  {%- if section.settings.intro != blank -%}
    <p class="flint-lede" style="padding-block: var(--sp-6);">{{ section.settings.intro }}</p>
  {%- endif -%}

  {%- paginate blog.articles by 12 -%}
    {%- if blog.articles.size > 0 -%}
      <div class="flint-tiles" style="--cols: 3; --cols-md: 2; --cols-sm: 1; padding-bottom: var(--section-pad);">
        {%- for article in blog.articles -%}
          <a class="flint-tile" href="{{ article.url }}">
            <div class="flint-media flint-media--room">
              {%- if article.image -%}
                {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy',
                   sizes: '(max-width: 767px) 100vw, 30vw', widths: '300,600,900,1200',
                   alt: article.image.alt | default: article.title }}
              {%- endif -%}
            </div>
            {%- if article.tags.size > 0 -%}
              <p class="flint-label" style="margin: var(--sp-3) 0 var(--sp-1);">{{ article.tags.first }}</p>
            {%- endif -%}
            <h2 class="flint-tile__title" style="margin-top: 0;">{{ article.title }}</h2>
            {%- if article.excerpt != blank -%}
              <p class="flint-card__meta" style="margin-top: var(--sp-2);">{{ article.excerpt | strip_html | truncate: 110 }}</p>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="flint-pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}<span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="flint-lede" style="padding-block: var(--sp-8);">Nothing here yet.</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Journal index",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "intro", "label": "Introduction",
      "default": "Guides to lighting a house properly, and the occasional story about one. Written to be useful whether or not you buy anything from us." }
  ]
}
{% endschema %}
