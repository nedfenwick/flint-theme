{%- comment -%}
  FLINT — HERO (§24, section 01)
  One image. One headline of six words or fewer. One link.
  No carousel, no video, no price, no offer.
  This is the LCP element: eager, high priority, never lazy-loaded.
{%- endcomment -%}

<section class="flint-hero flint-hero--light-type">
  <div class="flint-hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image
         | image_url: width: 3000
         | image_tag:
             loading: 'eager',
             fetchpriority: 'high',
             sizes: '100vw',
             widths: '750,1100,1500,1900,2400,3000',
             alt: section.settings.image.alt | default: section.settings.heading }}
    {%- else -%}
      <img src="{{ 'flint-ph-hero-hallway.webp' | asset_url }}"
           alt="{{ section.settings.heading | escape }}" fetchpriority="high">
    {%- endif -%}
  </div>

  <div class="flint-hero__inner">
    <div class="flint-container">
      {%- if section.settings.heading != blank -%}
        <h1 class="flint-hero__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="flint-btn flint-btn--light" href="{{ section.settings.link | default: '#' }}">
          {{ section.settings.link_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "One image, one line, one link. Compose the image with an even-toned area at the lower left for the headline. Do not add a second button." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Lighting, well considered.", "info": "Six words maximum. Sentence case." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View the range" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
