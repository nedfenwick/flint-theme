{%- comment -%}
  FLINT — CONTENT PAGE
  About, Trade, Delivery, Returns, Guarantee, Installation, Contact, policies.
  Measured column, serif headings, nothing decorative.
{%- endcomment -%}

<div class="flint-container">
  <header class="flint-page__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="flint-label">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="h2" style="margin-top: var(--sp-2);">{{ page.title }}</h1>
  </header>

  <div class="flint-page__body rte">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" }
  ]
}
{% endschema %}
