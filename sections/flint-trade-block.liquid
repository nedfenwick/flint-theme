{%- comment -%}
  FLINT — TRADE (§24, section 08)
  Present but understated. Signals seriousness to residential customers
  as much as it recruits professionals.
{%- endcomment -%}

<section class="flint-section flint-section--home flint-section--band">
  <div class="flint-container">
    <div class="flint-split flint-split--reverse">
      <div class="flint-stack">
        {%- if section.settings.label != blank -%}
          <p class="flint-label flint-label--accent">{{ section.settings.label }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <p class="flint-small" style="max-width: 38ch;">{{ section.settings.body }}</p>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="flint-btn flint-btn--primary" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>
      {% render 'flint-image', image: section.settings.image, placeholder: section.settings.placeholder,
         ratio: 'room', alt: section.settings.heading, sizes: '(max-width: 899px) 100vw, 45vw' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trade block",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Flint Trade" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "For designers, architects and developers" },
    { "type": "textarea", "id": "body", "label": "Body",
      "default": "Trade pricing from your first order. Specification sheets and dimensioned drawings on every product. Finish samples posted free." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Open a trade account" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "placeholder", "label": "Placeholder asset" }
  ],
  "presets": [{ "name": "Trade block" }]
}
{% endschema %}
