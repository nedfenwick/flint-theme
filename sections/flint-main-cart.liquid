{%- comment -%}
  FLINT — BASKET (§23)

  This section used to carry a note saying: no upsells, no free-delivery
  progress bar, no urgency. Two of those three still hold, and always will.
  The progress bar has been added deliberately, because it is not a persuasion
  device — it is information the shopper is entitled to and would otherwise
  have to work out with a calculator. "£12 away from free delivery" is a fact
  about their order. "Only 2 left, 14 people viewing" is not, and there is
  still none of that here.

  What the basket has to do, in order:
    1. Show what is in it, at a size you can check.
    2. Make quantity and removal obvious.
    3. Answer the delivery question before checkout, not during it.
    4. Get out of the way.

  Every figure below reads from settings so it stays in step with the delivery
  page. Change one, change both.
{%- endcomment -%}

{%- liquid
  assign threshold = section.settings.free_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign qualifies = false
  if threshold > 0 and cart.total_price >= threshold
    assign qualifies = true
  endif
-%}

<div class="flint-container flint-cart">
  <h1 class="h2">Basket</h1>

  {%- if cart.item_count > 0 -%}

    {%- if threshold > 0 -%}
      <div class="flint-ship" role="status">
        {%- if qualifies -%}
          <p class="flint-ship__line flint-ship__line--met">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="m5 12.5 4.5 4.5L19 7"/>
            </svg>
            Your order qualifies for free UK delivery.
          </p>
        {%- else -%}
          <p class="flint-ship__line">
            {{ remaining | money_without_trailing_zeros }} away from free UK delivery.
          </p>
        {%- endif -%}

        {%- assign pct = cart.total_price | times: 100 | divided_by: threshold -%}
        {%- if pct > 100 %}{% assign pct = 100 %}{% endif -%}
        <div class="flint-ship__track">
          <div class="flint-ship__fill" style="width: {{ pct }}%;"></div>
        </div>
      </div>
    {%- endif -%}

    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="flint-cart__layout">
        <div>
          {%- for item in cart.items -%}
            <div class="flint-cart__item">
              <a href="{{ item.url }}" class="flint-media flint-media--product" style="width:96px;" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
                {%- endif -%}
              </a>

              <div>
                <h2 class="flint-cart__title"><a href="{{ item.url }}">{{ item.product.title }}</a></h2>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="flint-cart__meta">{{ item.variant.title }}</p>
                {%- endunless -%}
                {%- if item.quantity > 1 -%}
                  <p class="flint-cart__meta">{{ item.final_price | money_without_trailing_zeros }} each</p>
                {%- endif -%}

                <div class="flint-qty">
                  <button type="button" aria-label="Reduce quantity of {{ item.product.title | escape }}" data-flint-qty="-1">&minus;</button>
                  <label class="visually-hidden" for="qty-{{ item.index | plus: 1 }}">Quantity</label>
                  <input id="qty-{{ item.index | plus: 1 }}" type="number" name="updates[]"
                         value="{{ item.quantity }}" min="0" inputmode="numeric" data-flint-qty-input>
                  <button type="button" aria-label="Increase quantity of {{ item.product.title | escape }}" data-flint-qty="1">+</button>
                </div>

                <a class="flint-cart__remove" href="{{ item.url_to_remove }}">Remove<span class="visually-hidden"> {{ item.product.title }}</span></a>
              </div>

              <p class="flint-price flint-price--card">{{ item.final_line_price | money_without_trailing_zeros }}</p>
            </div>
          {%- endfor -%}

          <a class="flint-link flint-cart__continue" href="{{ section.settings.continue_url | default: routes.all_products_collection_url }}">
            {{ section.settings.continue_label }}
          </a>
        </div>

        <aside class="flint-cart__summary">
          <div class="flint-cart__row">
            <span>Subtotal</span>
            <span class="flint-price flint-price--card">{{ cart.total_price | money_without_trailing_zeros }}</span>
          </div>
          <div class="flint-cart__row">
            <span>Delivery</span>
            <span>{% if qualifies %}Free{% else %}{{ section.settings.delivery_line }}{% endif %}</span>
          </div>
          <div class="flint-cart__row flint-cart__row--total">
            <span>Total</span>
            <span class="flint-price">{{ cart.total_price | money_without_trailing_zeros }}</span>
          </div>

          {%- if section.settings.tax_note != blank -%}
            <p class="flint-caption flint-cart__taxnote">{{ section.settings.tax_note }}</p>
          {%- endif -%}

          <button type="submit" name="checkout" class="flint-btn flint-btn--primary">Checkout</button>

          {%- comment -%}
            Shop Pay, PayPal and the wallets. On mobile these convert far better
            than a card form, because they skip the form entirely.
          {%- endcomment -%}
          {%- if additional_checkout_buttons and section.settings.show_wallets -%}
            <div class="flint-cart__wallets">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}

          <button type="submit" name="update" class="flint-btn flint-btn--secondary" style="margin-top:var(--sp-2);">Update basket</button>

          {%- if section.settings.reassurance != blank -%}
            <ul class="flint-cart__assure">
              {%- assign lines = section.settings.reassurance | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign trimmed = line | strip -%}
                {%- if trimmed != blank -%}<li>{{ trimmed }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
            <div class="flint-cart__pay" role="img" aria-label="Payment methods accepted">
              {%- for type in shop.enabled_payment_types -%}
                {{ type | payment_type_svg_tag: class: 'flint-cart__pay-icon' }}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </aside>
      </div>
    </form>

  {%- else -%}
    <div class="flint-cart__empty">
      <p class="flint-lede">Your basket is empty.</p>
      <p class="flint-small" style="margin-top: var(--sp-3);">
        {{ section.settings.empty_note }}
      </p>
      <a class="flint-btn flint-btn--primary" href="{{ section.settings.empty_url | default: routes.all_products_collection_url }}"
         style="margin-top: var(--sp-5);">
        {{ section.settings.empty_label }}
      </a>
    </div>
  {%- endif -%}
</div>

<style>
  .flint-ship { margin-block: var(--sp-5) var(--sp-6); max-width: 480px; }
  .flint-ship__line {
    font-family: var(--font-sans); font-size: var(--size-small);
    color: var(--text-primary); margin: 0 0 var(--sp-2);
    display: flex; align-items: center; gap: var(--sp-2);
  }
  .flint-ship__line--met { color: var(--brass-deep); }
  .flint-ship__track { height: 2px; background: var(--border-default); overflow: hidden; }
  .flint-ship__fill { height: 2px; background: var(--brass); transition: width var(--dur-slow) var(--ease); }

  .flint-cart__continue { display: inline-block; margin-top: var(--sp-5); }

  @media (min-width: 900px) {
    .flint-cart__summary { position: sticky; top: var(--sp-5); }
  }

  .flint-cart__taxnote { margin: var(--sp-2) 0 var(--sp-4); color: var(--text-secondary); }

  .flint-cart__wallets { margin-top: var(--sp-3); display: grid; gap: var(--sp-2); }
  .flint-cart__wallets > * { width: 100%; }

  .flint-cart__assure {
    list-style: none; margin: var(--sp-5) 0 0; padding: var(--sp-4) 0 0;
    border-top: var(--hairline) solid var(--border-default);
  }
  .flint-cart__assure li {
    font-family: var(--font-sans); font-size: var(--size-cap);
    color: var(--text-secondary); margin: 0 0 var(--sp-2); padding-left: 16px;
    position: relative; line-height: 1.5;
  }
  .flint-cart__assure li::before {
    content: ""; position: absolute; left: 0; top: 7px;
    width: 5px; height: 5px; background: var(--brass);
  }

  .flint-cart__pay { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--sp-4); }
  .flint-cart__pay svg { height: 22px; width: auto; opacity: .75; }

  .flint-cart__empty { padding-block: var(--sp-8); max-width: 52ch; }
</style>

<script>
  (function () {
    document.querySelectorAll('[data-flint-qty]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var input = btn.parentNode.querySelector('[data-flint-qty-input]');
        if (!input) return;
        var next = Math.max(0, parseInt(input.value, 10) + parseInt(btn.dataset.flintQty, 10));
        input.value = next;
        input.form.querySelector('[name="update"]').click();
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Free delivery threshold" },
    { "type": "range", "id": "free_threshold", "label": "Free delivery over", "unit": "£",
      "min": 0, "max": 150, "step": 5, "default": 50,
      "info": "Must match the shipping rate in Settings. Set to 0 to hide the progress bar." },
    { "type": "header", "content": "Summary" },
    { "type": "text", "id": "delivery_line", "label": "Delivery line", "default": "Calculated at checkout" },
    { "type": "text", "id": "tax_note", "label": "Tax note", "default": "No VAT is charged. The price you see is the price you pay." },
    { "type": "checkbox", "id": "show_wallets", "label": "Show express checkout buttons", "default": true,
      "info": "Shop Pay, PayPal and wallets. These convert markedly better on mobile." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment method icons", "default": true },
    { "type": "textarea", "id": "reassurance", "label": "Reassurance list",
      "default": "Dispatched from the UK on a tracked service\n14 days to change your mind\nTwo-year guarantee on every fitting\nSecure checkout",
      "info": "One per line. Every line must match the delivery and returns pages." },
    { "type": "header", "content": "Links" },
    { "type": "text", "id": "continue_label", "label": "Continue shopping label", "default": "Continue shopping" },
    { "type": "url", "id": "continue_url", "label": "Continue shopping link" },
    { "type": "header", "content": "Empty basket" },
    { "type": "text", "id": "empty_note", "label": "Note",
      "default": "Not sure where to start? Wall lights do the quiet work in most houses." },
    { "type": "text", "id": "empty_label", "label": "Link label", "default": "Shop all lighting" },
    { "type": "url", "id": "empty_url", "label": "Link" },
    { "type": "paragraph", "content": "No upsells, no countdowns, no stock scarcity. The progress bar states a fact about the order; nothing here manufactures urgency." }
  ]
}
{% endschema %}
