{%- comment -%}
  FLINT — COLLECTION (Brand Manual §23)

  Category intro, four across, editorial break after row three, curated
  default sort, pagination rather than infinite scroll.

  Filters come from Shopify's native storefront filtering, configured in the
  free Search & Discovery app. The ones that matter here — width, drop,
  IP rating, dimmable, bulb included — are the ones competitors don't offer.
{%- endcomment -%}

{%- liquid
  assign intro = collection.metafields.flint.intro.value | default: collection.description
  assign break_after = section.settings.break_after
-%}

<div class="flint-container">

  {% render 'flint-breadcrumb', collection: collection %}

  <header class="flint-coll__head">
    <h1 class="h2">{{ collection.title }}</h1>
    {%- if intro != blank -%}
      <div class="flint-coll__intro">{{ intro }}</div>
    {%- endif -%}
  </header>

  <div class="flint-coll__layout">

    {%- comment -%} ── FILTERS ─────────────────────────────────────────── {%- endcomment -%}
    <form id="flint-filter-form" class="flint-filters" data-flint-filters>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--sp-3);">
        <p class="flint-label" style="margin:0;">Filter</p>
        <button type="button" class="flint-filters__close flint-header__icon" data-flint-filters-close aria-label="Close filters">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M5 5l14 14M19 5L5 19"/></svg>
        </button>
      </div>

      {%- if collection.filters.size > 0 -%}
        {%- for filter in collection.filters -%}
          <details class="flint-filters__group" {% if filter.active_values.size > 0 %}open{% endif %}>
            <summary>{{ filter.label }}</summary>
            <div class="flint-filters__body">
              {%- case filter.type -%}
                {%- when 'list' -%}
                  {%- for value in filter.values -%}
                    <label class="flint-filters__row {% if value.count == 0 and value.active == false %}is-disabled{% endif %}">
                      <input type="checkbox"
                             name="{{ value.param_name }}"
                             value="{{ value.value }}"
                             {% if value.active %}checked{% endif %}
                             {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                      <span>{{ value.label }}</span>
                      <span class="count">{{ value.count }}</span>
                    </label>
                  {%- endfor -%}

                {%- when 'price_range' -%}
                  <div class="flint-filters__range">
                    <input class="flint-field" type="number" inputmode="numeric"
                           name="{{ filter.min_value.param_name }}"
                           value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                           placeholder="Min" min="0" aria-label="{{ filter.label | escape }}, minimum"
                           style="height:40px;font-size:13px;">
                    <span class="flint-small">to</span>
                    <input class="flint-field" type="number" inputmode="numeric"
                           name="{{ filter.max_value.param_name }}"
                           value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                           placeholder="Max" min="0" aria-label="{{ filter.label | escape }}, maximum"
                           style="height:40px;font-size:13px;">
                  </div>
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}
      {%- else -%}
        <p class="flint-small">
          {%- if request.design_mode -%}
            No filters configured yet. Install the free <strong>Search &amp; Discovery</strong>
            app and enable filters on the flint metafields — width, drop, IP rating,
            dimmable and bulb included are the ones worth having.
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- comment -%} keep the current sort when filters change {%- endcomment -%}
      {%- if collection.sort_by != blank -%}
        <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
      {%- endif -%}

      <div class="flint-filters__apply">
        <button type="button" class="flint-btn flint-btn--primary" data-flint-filters-close>
          Show {{ collection.products_count }} products
        </button>
      </div>
    </form>

    {%- comment -%} ── RESULTS ─────────────────────────────────────────── {%- endcomment -%}
    <div>
      <div class="flint-coll__bar">
        <button type="button" class="flint-btn flint-btn--secondary flint-filters__toggle"
                data-flint-filters-open style="min-height:40px;padding:0 18px;">
          Filter
        </button>

        <p class="flint-coll__count">
          {{ collection.products_count }}
          {%- if collection.products_count == 1 %} product{% else %} products{% endif -%}
        </p>

        {%- if collection.sort_options.size > 0 -%}
          <label class="visually-hidden" for="flint-sort">Sort by</label>
          <select id="flint-sort" class="flint-coll__sort" data-flint-sort>
            {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>
                {{ option.name }}
              </option>
            {%- endfor -%}
          </select>
        {%- endif -%}
      </div>

      {%- comment -%} active filter chips {%- endcomment -%}
      {%- assign has_active = false -%}
      {%- for filter in collection.filters -%}
        {%- if filter.active_values.size > 0 -%}{%- assign has_active = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if has_active -%}
        <div class="flint-chips">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a class="flint-chip" href="{{ value.url_to_remove }}">{{ value.label }}</a>
            {%- endfor -%}
          {%- endfor -%}
          <a class="flint-chip" href="{{ collection.url }}" style="border-color:var(--border-strong);">Clear all</a>
        </div>
      {%- endif -%}

      {%- paginate collection.products by 24 -%}
        {%- if collection.products.size > 0 -%}
          <div class="flint-tiles" style="--cols: 4; --cols-md: 3; --cols-sm: 2;">
            {%- for product in collection.products -%}
              {% render 'flint-product-card', product: product, sizes: '(max-width: 767px) 50vw, (max-width: 1023px) 30vw, 22vw' %}

              {%- comment -%}
                Editorial break after row three. Breaks the grid, adds authority,
                and stops the page reading as a catalogue. (§23)
              {%- endcomment -%}
              {%- if break_after > 0 and forloop.index == break_after and section.settings.break_heading != blank -%}
                <div class="flint-coll__break">
                  <div class="flint-split">
                    {% render 'flint-image',
                       image: section.settings.break_image,
                       placeholder: section.settings.break_placeholder,
                       ratio: 'room',
                       alt: section.settings.break_heading,
                       sizes: '(max-width: 899px) 100vw, 45vw' %}
                    <div class="flint-stack">
                      <p class="flint-label flint-label--accent">{{ section.settings.break_kicker }}</p>
                      <h2 class="h3">{{ section.settings.break_heading }}</h2>
                      {%- if section.settings.break_body != blank -%}
                        <p class="flint-small" style="max-width:38ch;">{{ section.settings.break_body }}</p>
                      {%- endif -%}
                      {%- if section.settings.break_link != blank -%}
                        <a class="flint-link" href="{{ section.settings.break_link }}">{{ section.settings.break_link_label }}</a>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="flint-pagination" aria-label="Pagination">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}">{{ part.title }}</a>
                {%- else -%}
                  <span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next</a>{%- endif -%}
            </nav>
          {%- endif -%}

        {%- else -%}
          <div style="padding-block: var(--sp-8);">
            <p class="flint-lede">Nothing matches those filters.</p>
            <p class="flint-small" style="margin-top: var(--sp-3);">
              Try removing one, or <a class="flint-link" href="{{ collection.url }}">see everything in {{ collection.title | downcase }}</a>.
            </p>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var form = document.querySelector('[data-flint-filters]');
    var panel = form;

    /* Filters submit themselves — no Apply button on desktop. */
    if (form) {
      form.addEventListener('change', function (e) {
        if (e.target.matches('input[type="checkbox"]')) form.submit();
      });
      form.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && e.target.matches('input[type="number"]')) { e.preventDefault(); form.submit(); }
      });
    }

    var sort = document.querySelector('[data-flint-sort]');
    if (sort) {
      sort.addEventListener('change', function () {
        var url = new URL(window.location.href);
        url.searchParams.set('sort_by', sort.value);
        url.searchParams.delete('page');
        window.location.href = url.toString();
      });
    }

    document.querySelectorAll('[data-flint-filters-open]').forEach(function (btn) {
      btn.addEventListener('click', function () { panel.classList.add('is-open'); document.body.style.overflow = 'hidden'; });
    });
    document.querySelectorAll('[data-flint-filters-close]').forEach(function (btn) {
      btn.addEventListener('click', function () { panel.classList.remove('is-open'); document.body.style.overflow = ''; });
    });
  })();
</script>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "The category introduction comes from the collection's Category introduction metafield, or its description. 30 to 50 words, useful rather than promotional." },
    { "type": "header", "content": "Editorial break" },
    { "type": "paragraph", "content": "A full-width block inserted part-way down the grid. It breaks the catalogue rhythm and links to a guide. Set the heading blank to switch it off." },
    { "type": "range", "id": "break_after", "min": 0, "max": 24, "step": 4, "default": 12, "label": "Insert after N products", "info": "0 turns it off. 12 puts it after row three." },
    { "type": "text", "id": "break_kicker", "label": "Kicker", "default": "Guide" },
    { "type": "text", "id": "break_heading", "label": "Heading" },
    { "type": "textarea", "id": "break_body", "label": "Body" },
    { "type": "text", "id": "break_link_label", "label": "Link label", "default": "Read the guide" },
    { "type": "url", "id": "break_link", "label": "Link" },
    { "type": "image_picker", "id": "break_image", "label": "Image" },
    { "type": "text", "id": "break_placeholder", "label": "Placeholder asset" }
  ]
}
{% endschema %}
