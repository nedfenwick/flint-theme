{%- comment -%}
  FLINT — EDITORIAL STATEMENT (§24, section 04)
  The brand's core idea in the serif. One of the few permitted centred blocks.
  Maximum 30 words.
{%- endcomment -%}

<section class="flint-section flint-section--home{% if section.settings.band %} flint-section--band{% endif %}">
  <div class="flint-container flint-text-center">
    {%- if section.settings.statement != blank -%}
      <p class="flint-statement">{{ section.settings.statement }}</p>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <p style="margin-top: var(--sp-5);">
        <a class="flint-link" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Editorial statement",
  "tag": "div",
  "settings": [
    { "type": "textarea", "id": "statement", "label": "Statement",
      "default": "The details that finish a room should be considered as carefully as the room itself. That is the whole of it.",
      "info": "Maximum 30 words. This is the one place the brand states its idea outright." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Our approach" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "band", "label": "Cortex background band", "default": false }
  ],
  "presets": [{ "name": "Editorial statement" }]
}
{% endschema %}
