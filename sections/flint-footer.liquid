{%- comment -%}
  FLINT — FOOTER (Brand Manual §23)
  The one place on the site where density is welcome, and the only place
  where the wordmark and the brand line appear together as a matter of course.
{%- endcomment -%}

<footer class="flint-footer">
  <div class="flint-container">
    <div class="flint-footer__grid">

      <div>
        <a class="flint-footer__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — home">
          {% render 'flint-logo', colour: '#FAF7F2', width: '128px' %}
        </a>
        {%- if section.settings.brand_line != blank -%}
          <p style="font-family: var(--font-serif); font-weight: 300; font-size: var(--size-small); color: var(--text-inverse); margin-bottom: var(--sp-4);">
            {{ section.settings.brand_line }}
          </p>
        {%- endif -%}
        {%- if section.settings.legal_name != blank -%}
          <p class="flint-caption" style="color: rgba(226,220,208,.45);">{{ section.settings.legal_name }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h2 class="flint-label flint-label--brass">{{ block.settings.heading }}</h2>
            {%- if block.settings.menu != blank -%}
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    <div class="flint-footer__legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.legal_name | default: shop.name }}</span>
      <span>
        {%- for link in section.settings.legal_menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>{% unless forloop.last %} &middot; {% endunless %}
        {%- endfor -%}
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_line",
      "label": "Brand line",
      "default": "Lighting, well considered.",
      "info": "The footer is one of the few places the brand line and wordmark appear together."
    },
    { "type": "text", "id": "legal_name", "label": "Legal name", "default": "Flint Lighting Ltd" },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu", "info": "Terms, Privacy, Cookies, Accessibility" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "default": {
    "settings": {},
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop", "menu": "footer-shop" } },
      { "type": "menu", "settings": { "heading": "Help", "menu": "footer-help" } },
      { "type": "menu", "settings": { "heading": "Trade" } },
      { "type": "menu", "settings": { "heading": "Journal" } }
    ]
  }
}
{% endschema %}
