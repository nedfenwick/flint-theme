{%- comment -%}
  FLINT - HEADER (Brand Manual section 23)
  76px Chalk. Six-item nav, uppercase, brass hairline active state.
  Full-width mega menu on items with children. No announcement bar, ever.
{%- endcomment -%}

{%- if section.settings.show_utility -%}
  <div class="flint-utility">
    <div class="flint-container flint-utility__inner">
      {%- for block in section.blocks -%}
        {%- if block.type == 'utility_link' -%}
          <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{- block.settings.label -}}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

<header class="flint-header" data-flint-header>
  <div class="flint-container flint-header__inner">

    <button class="flint-header__icon flint-header__burger" aria-label="Menu"
            aria-expanded="false" aria-controls="flint-mobile-nav" data-flint-menu-toggle>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
        <path d="M3 7h18M3 12h18M3 17h18"/>
      </svg>
    </button>

    <a class="flint-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      {% render 'flint-logo', colour: '#2A2724', width: '100%' %}
    </a>

    <nav class="flint-nav" aria-label="Main">
      {%- for link in section.settings.menu.links -%}
        {%- if link.links.size > 0 -%}
          <div class="flint-nav__item" data-flint-nav-item>
            <a href="{{ link.url }}"
               aria-haspopup="true" aria-expanded="false"
               {% if link.active or link.child_active %}aria-current="page"{% endif %}>{{ link.title }}</a>

            <div class="flint-mega" data-flint-mega>
              <div class="flint-container flint-mega__inner">
                <div class="flint-mega__cols">
                  {%- for child in link.links -%}
                    <div class="flint-mega__col">
                      <a class="flint-mega__head" href="{{ child.url }}">{{ child.title }}</a>
                      {%- if child.links.size > 0 -%}
                        <ul>
                          {%- for grandchild in child.links -%}
                            <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>

                {%- if section.settings.mega_image != blank or section.settings.mega_placeholder != blank -%}
                  <a class="flint-mega__feature" href="{{ section.settings.mega_link | default: '#' }}">
                    {% render 'flint-image',
                       image: section.settings.mega_image,
                       placeholder: section.settings.mega_placeholder,
                       ratio: 'room',
                       alt: section.settings.mega_caption,
                       sizes: '30vw' %}
                    {%- if section.settings.mega_caption != blank -%}
                      <p class="flint-tile__title" style="font-size:var(--size-small);">{{ section.settings.mega_caption }}</p>
                    {%- endif -%}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- else -%}
          <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="flint-header__actions">
      <a class="flint-header__icon" href="{{ routes.search_url }}" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"/><path d="M15.8 15.8 20 20"/>
        </svg>
      </a>
      <a class="flint-header__icon" href="{{ routes.cart_url }}" aria-label="Basket, {{ cart.item_count }} items">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
          <path d="M5 7h14l1 13H4z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/>
        </svg>
      </a>
    </div>
  </div>

  <div class="flint-mobile-nav" id="flint-mobile-nav" hidden>
    <div class="flint-container">
      <ul>
        {%- for link in section.settings.menu.links -%}
          <li>
            <a href="{{ link.url }}">{{ link.title }}</a>
            {%- if link.links.size > 0 -%}
              <ul class="flint-mobile-nav__sub">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      <ul class="flint-mobile-nav__utility">
        {%- for block in section.blocks -%}
          {%- if block.type == 'utility_link' -%}
            <li><a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</header>

<style>
  .flint-header { position: relative; }
  .flint-nav__item { position: static; display: flex; align-items: center; }
  .flint-nav__item > a { display: inline-block; }

  .flint-mega {
    position: absolute; left: 0; right: 0; top: 100%; z-index: 50;
    background: var(--surface-raised);
    border-top: var(--hairline) solid var(--border-default);
    border-bottom: var(--hairline) solid var(--border-default);
    padding-block: clamp(24px, 3vw, 48px);
    opacity: 0; visibility: hidden;
    transition: opacity var(--dur-fast) var(--ease), visibility var(--dur-fast) var(--ease);
  }
  .flint-nav__item:hover .flint-mega,
  .flint-nav__item:focus-within .flint-mega { opacity: 1; visibility: visible; }

  .flint-mega__inner { display: grid; grid-template-columns: 1fr auto; gap: clamp(24px, 4vw, 64px); align-items: start; }
  .flint-mega__cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-5) var(--grid-gap); }
  .flint-mega__col ul { list-style: none; margin: var(--sp-2) 0 0; padding: 0; }
  .flint-mega__col li { margin: 0; }

  .flint-mega a {
    font-family: var(--font-sans); font-size: var(--size-small);
    letter-spacing: 0; text-transform: none; font-weight: var(--weight-regular);
    color: var(--text-secondary); text-decoration: none;
    display: block; padding-block: 5px; border: 0;
  }
  .flint-mega a:hover { color: var(--text-primary); }
  .flint-mega__head { color: var(--text-primary) !important; font-weight: var(--weight-medium) !important; }
  .flint-mega__feature { width: clamp(200px, 22vw, 300px); }
  .flint-mega__feature p { margin-top: var(--sp-2); color: var(--text-primary) !important; }

  @media (max-width: 1023px) { .flint-mega__feature { display: none; } }
  @media (max-width: 899px) { .flint-mega { display: none; } }

  .flint-mobile-nav { border-bottom: var(--hairline) solid var(--border-default); background: var(--surface-page); }
  .flint-mobile-nav[hidden] { display: none; }
  .flint-mobile-nav ul { list-style: none; margin: 0; padding: 0 0 var(--sp-4); }
  .flint-mobile-nav li { margin: 0; }
  .flint-mobile-nav a {
    display: block; padding: var(--sp-3) 0;
    font-family: var(--font-serif); font-size: 18px; font-weight: var(--weight-regular);
    color: var(--text-primary); text-decoration: none;
    border-bottom: var(--hairline) solid var(--border-default);
    min-height: var(--tap-min);
  }
  .flint-mobile-nav__sub { padding: 0 0 var(--sp-2) var(--sp-4); }
  .flint-mobile-nav__sub a { font-family: var(--font-sans); font-size: var(--size-small); color: var(--text-secondary); border-bottom: 0; padding: var(--sp-2) 0; min-height: 40px; }
  .flint-mobile-nav__utility a { font-family: var(--font-sans); font-size: var(--size-small); color: var(--text-secondary); border-bottom: 0; padding: var(--sp-2) 0; }
  @media (min-width: 900px) { .flint-mobile-nav { display: none; } }
</style>

<script>
  (function () {
    var btn = document.querySelector('[data-flint-menu-toggle]');
    var nav = document.getElementById('flint-mobile-nav');
    if (btn && nav) {
      btn.addEventListener('click', function () {
        var open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        nav.hidden = open;
      });
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && document.activeElement) document.activeElement.blur();
    });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu",
      "info": "Six items maximum. Items with sub-items open a full-width menu." },
    { "type": "checkbox", "id": "show_utility", "label": "Show utility bar", "default": true },
    { "type": "header", "content": "Menu feature image" },
    { "type": "image_picker", "id": "mega_image", "label": "Image" },
    { "type": "text", "id": "mega_placeholder", "label": "Placeholder asset" },
    { "type": "text", "id": "mega_caption", "label": "Caption" },
    { "type": "url", "id": "mega_link", "label": "Link" },
    { "type": "paragraph", "content": "There is no announcement bar in this theme by design. If a message matters enough to announce, it belongs on the product page where the decision is made." }
  ],
  "blocks": [
    { "type": "utility_link", "name": "Utility link", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Trade" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "default": {
    "settings": {},
    "blocks": [
      { "type": "utility_link", "settings": { "label": "Trade" } },
      { "type": "utility_link", "settings": { "label": "Finish samples" } },
      { "type": "utility_link", "settings": { "label": "About" } }
    ]
  }
}
{% endschema %}
