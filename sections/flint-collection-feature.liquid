{%- comment -%}
  FLINT — SELECTED COLLECTION (§24, section 03)
  7 + 5 asymmetric split. One collection at a time. Changes monthly at most.
{%- endcomment -%}

<section class="flint-section flint-section--home{% if section.settings.band %} flint-section--band{% endif %}">
  <div class="flint-container">
    <div class="flint-split{% if section.settings.image_right %} flint-split--reverse{% endif %}">

      {%- unless section.settings.image_right -%}
        {% render 'flint-image', image: section.settings.image, placeholder: section.settings.placeholder,
           ratio: 'room', alt: section.settings.heading, sizes: '(max-width: 899px) 100vw, 55vw' %}
      {%- endunless -%}

      <div class="flint-stack">
        {%- if section.settings.label != blank -%}
          <p class="flint-label flint-label--accent">{{ section.settings.label }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <p class="flint-small" style="max-width: 36ch;">{{ section.settings.body }}</p>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="flint-btn flint-btn--secondary" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.image_right -%}
        {% render 'flint-image', image: section.settings.image, placeholder: section.settings.placeholder,
           ratio: 'room', alt: section.settings.heading, sizes: '(max-width: 899px) 100vw, 55vw' %}
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection feature",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Selected collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Cley Collection" },
    { "type": "textarea", "id": "body", "label": "Body", "info": "30 to 50 words. Describe rather than sell." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore the collection" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "placeholder", "label": "Placeholder asset" },
    { "type": "checkbox", "id": "image_right", "label": "Image on the right", "default": false },
    { "type": "checkbox", "id": "band", "label": "Cortex background band", "default": true }
  ],
  "presets": [{ "name": "Collection feature" }]
}
{% endschema %}
