{%- comment -%}
  FLINT — SELF-HOSTED FONTS (§14)

  Replaces the render-blocking Google Fonts request. Roughly half a second of
  LCP on a 4G connection, and no third-party DNS lookup on first paint.

  BEFORE THIS WORKS, four files must exist in assets/:
    newsreader-latin.woff2       newsreader-latin-italic.woff2
    inter-latin.woff2            inter-latin-ext.woff2

  See FONTS.md for where to get them. Until they are uploaded, leave the
  Google Fonts <link> in theme.liquid and do not render this snippet.
{%- endcomment -%}

<link rel="preload" as="font" type="font/woff2" crossorigin
      href="{{ 'newsreader-latin.woff2' | asset_url }}">
<link rel="preload" as="font" type="font/woff2" crossorigin
      href="{{ 'inter-latin.woff2' | asset_url }}">

<style>
  /* Newsreader — variable, optical size 6–72, weight 200–500 */
  @font-face {
    font-family: 'Newsreader';
    src: url('{{ 'newsreader-latin.woff2' | asset_url }}') format('woff2-variations');
    font-weight: 200 500;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F,
                   U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215;
  }
  @font-face {
    font-family: 'Newsreader';
    src: url('{{ 'newsreader-latin-italic.woff2' | asset_url }}') format('woff2-variations');
    font-weight: 200 500;
    font-style: italic;
    font-display: swap;
  }

  /* Inter — variable, weight 300–600 */
  @font-face {
    font-family: 'Inter';
    src: url('{{ 'inter-latin.woff2' | asset_url }}') format('woff2-variations');
    font-weight: 300 600;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F,
                   U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215;
  }
  @font-face {
    font-family: 'Inter';
    src: url('{{ 'inter-latin-ext.woff2' | asset_url }}') format('woff2-variations');
    font-weight: 300 600;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0100-02AF, U+0304, U+0308, U+0329, U+1E00-1E9F, U+1EF2-1EFF,
                   U+2020, U+20A0-20AB, U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
</style>
