{%- comment -%}
  FLINT — ORGANISATION IDENTITY (structured data)

  Rendered on every page. This is the machine-readable half of the trading
  disclosure in the footer: the same name, the same address, the same email.
  Google's shopping and merchant reviews look for a consistent, verifiable
  identity across the site, the structured data and the Merchant Center
  account, and an inconsistency between the three is a common reason for a
  new account to be held back.

  `legalName` is the natural person who trades — there is no company here, so
  there is no company number to claim, and inventing one would be worse than
  leaving it out.
{%- endcomment -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "OnlineStore",
  "@id": "{{ shop.url }}/#organisation",
  "name": {{ shop.name | json }},
  "legalName": "Ned Fenwick, trading as Flint",
  "url": {{ shop.url | json }},
  "description": "Flint sells warm, architectural lighting for British homes. Wall lights, pendants, picture lights and lamps in aged brass, bronze and opal glass, dispatched tracked from within the UK.",
  "slogan": "Lighting, well considered.",
  "email": "hello@flintlighting.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Shilstone, Modbury",
    "addressLocality": "Ivybridge",
    "addressRegion": "Devon",
    "postalCode": "PL21 0TW",
    "addressCountry": "GB"
  },
  "areaServed": { "@type": "Country", "name": "United Kingdom" },
  "currenciesAccepted": "GBP",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "email": "hello@flintlighting.com",
    "url": "{{ shop.url }}/pages/contact",
    "availableLanguage": "English",
    "areaServed": "GB"
  },
  "hasMerchantReturnPolicy": {
    "@type": "MerchantReturnPolicy",
    "applicableCountry": "GB",
    "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
    "merchantReturnDays": 14,
    "returnMethod": "https://schema.org/ReturnByMail",
    "returnFees": "https://schema.org/ReturnShippingFees",
    "merchantReturnLink": "{{ shop.url }}/pages/returns"
  }
}
</script>
