<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#2A2724">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {%- comment -%}
      FONTS
      Loaded from Google Fonts for now so the theme works immediately.
      BEFORE LAUNCH: download Newsreader and Inter, subset to Latin + Latin-Ext
      (keeping £ × · — ‘ ’ “ ”), upload as theme assets and swap this for
      self-hosted @font-face. Target: ≤140KB total. Brand Manual §14.
    {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,200;6..72,300;6..72,400;6..72,500&family=Inter:wght@300;400;500;600&display=swap"
    >

    {%- comment -%}
      Dawn's stylesheet is loaded on every template EXCEPT those we have
      rebuilt in the Flint system. It is scaffolding: as each template is
      replaced, remove it from this list. When the list is empty, delete
      the line — and Dawn's CSS with it.
    {%- endcomment -%}
    {%- assign flint_templates = 'index,product,collection' -%}
    {%- unless flint_templates contains template.name -%}
      {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- endunless -%}

    {{ 'flint-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'flint-base.css' | asset_url | stylesheet_tag }}
    {{ 'flint-components.css' | asset_url | stylesheet_tag }}

    {%- if template.name == 'product' -%}
      {{ 'flint-product.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {%- if template.name == 'collection' -%}
      {{ 'flint-collection.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

    {{ content_for_header }}

    {%- comment -%} Organisation structured data — Brand Manual §23 {%- endcomment -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }},
        "description": "Flint designs warm, architectural lighting for British homes and considered commercial interiors. Wall lights, pendants, picture lights and lamps in aged brass, bronze and opal glass.",
        "slogan": "Lighting, well considered."
      }
    </script>
  </head>

  <body class="template-{{ template.name }}">
    <a class="flint-skip-link" href="#main">Skip to content</a>

    {% section 'flint-header' %}

    <main id="main" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'flint-footer' %}
  </body>
</html>
